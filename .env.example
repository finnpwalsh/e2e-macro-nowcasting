# FRED API
FRED_API_KEY=your_api_key_here

# Airflow Secret Key
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_a_long_random_string_32plus_chars

# Airflow database (local / dev)
AIRFLOW_DB_URI=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>

# AWS
STORAGE_BACKEND=S3

AWS_REGION=us-east-1
AWS_PROFILE=<aws-profile-name>

AWS_S3_BUCKET_DATA=<your-data-bucket>
AWS_S3_BUCKET_ARTIFACTS=<your-artifacts-bucket>

# MLflow
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=nowcasting
MLFLOW_REGISTRY_MODEL_NAME=nowcasting-models
MLFLOW_MODEL_ALIAS=champion

# GitPython (optional)
GIT_PYTHON_REFRESH=quiet
GIT_PYTHON_GIT_EXECUTABLE=/usr/bin/git